<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="client_request_template" name="Telegram Client Request">
        &lt;!DOCTYPE html&gt;
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=no, viewport-fit=cover"/>
                <title>Zakaz Berish</title>
                <!-- Include Telegram Web App Script -->
                <script src="https://telegram.org/js/telegram-web-app.js"></script>
                <!-- Tailwind CSS for fast styling (using a CDN for standalone template) -->
                <script src="https://cdn.tailwindcss.com"></script>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                
                <style>
                    body {
                        background-color: var(--tg-theme-bg-color, #ffffff);
                        color: var(--tg-theme-text-color, #000000);
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        padding-bottom: 80px;
                    }
                    .hint-color { color: var(--tg-theme-hint-color, #999999); }
                    .link-color { color: var(--tg-theme-link-color, #2481cc); }
                    .button-color { background-color: var(--tg-theme-button-color, #2481cc); color: var(--tg-theme-button-text-color, #ffffff); }
                    
                    /* Custom Scrollbar for products */
                    ::-webkit-scrollbar { width: 6px; height: 6px; }
                    ::-webkit-scrollbar-track { background: transparent; }
                    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
                </style>
            </head>
            
            <body class="antialiased">
                <div id="app" class="max-w-md mx-auto relative min-h-screen flex flex-col">
                    
                    <!-- Header -->
                    <div class="px-5 pt-6 pb-4 border-b border-gray-100 flex items-center justify-between sticky top-0 bg-white z-10 shadow-sm" style="background-color: var(--tg-theme-bg-color, #ffffff);">
                        <h1 class="text-xl font-bold">Yangi So'rov 🛍️</h1>
                        <div class="flex items-center space-x-2 bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm font-semibold">
                            <i class="fa fa-user"></i>
                            <span id="clientName"><t t-esc="partner_name"/></span>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <div class="flex-1 p-4 mb-20">
                        
                        <div class="mb-5 flex items-center justify-between">
                            <h2 class="font-bold text-lg">Xarid qutisi</h2>
                            <span id="totalItemsBadge" class="bg-gray-100 text-gray-600 text-xs font-bold px-2 py-1 rounded-md">0 ta mahsulot</span>
                        </div>
                        
                        <!-- Selected Products List -->
                        <div id="cartList" class="space-y-3 mb-6">
                            <!-- Populated by JS -->
                            <div id="emptyCart" class="text-center py-8 px-4 border-2 border-dashed border-gray-200 rounded-xl hint-color">
                                <i class="fa fa-box-open text-4xl mb-3 opacity-50"></i>
                                <p class="text-sm font-medium">Savat bo'sh. Pastdan mahsulot qo'shing.</p>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-bold mb-2 hint-color">Izoh (Ixtiyoriy)</label>
                            <textarea id="requestNotes" rows="2" placeholder="Qo'shimcha talablaringiz..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm bg-gray-50" style="color: var(--tg-theme-text-color, #000000); background-color: var(--tg-theme-secondary-bg-color, #f3f4f6);"></textarea>
                        </div>

                        <!-- Product Selector Section -->
                        <div class="border-t border-gray-100 pt-6">
                            <h2 class="font-bold text-lg mb-4 flex items-center"><i class="fa fa-list mr-2 text-blue-500"></i> Barcha Mahsulotlar</h2>
                            
                            <div class="mb-4">
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fa fa-search text-gray-400"></i>
                                    </div>
                                    <input type="text" id="searchInput" placeholder="Nomi bo'yicha qidirish..." class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition text-sm bg-gray-50" style="color: var(--tg-theme-text-color, #000000); background-color: var(--tg-theme-secondary-bg-color, #f3f4f6);"/>
                                </div>
                            </div>

                            <div id="productGrid" class="grid grid-cols-2 gap-3 pb-8">
                                <t t-foreach="products" t-as="p">
                                    <div class="product-card bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition cursor-pointer flex flex-col" style="background-color: var(--tg-theme-bg-color, #ffffff);" data-id="<t t-esc='p.id'/>" data-name="<t t-esc='p.name'/>" data-price="<t t-esc='p.price'/>" data-img="<t t-esc='p.image_url'/>">
                                        <div class="h-28 bg-gray-50 flex items-center justify-center p-2 relative">
                                            <t t-if="p.image_url">
                                                <img src="<t t-esc='p.image_url'/>" onerror="this.src='/van_sales_pharma/static/description/icon.png';" class="max-h-full max-w-full object-contain rounded-md"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-box text-3xl text-gray-300"></i>
                                            </t>
                                        </div>
                                        <div class="p-3 flex-1 flex flex-col">
                                            <div class="font-semibold text-sm mb-1 leading-tight line-clamp-2 flex-1 product-name"><t t-esc="p.name"/></div>
                                            <div class="text-xs text-green-600 font-bold mt-2"><t t-esc="p.price_str"/> UZS</div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Web App Main Button Integration Scripts -->
                <script>
                    const tg = window.Telegram.WebApp;
                    tg.expand(); // Expand to full height

                    // Injecting backend data
                    const partnerId = <t t-esc="partner_id"/>;
                    const odooUrl = "<t t-esc="odoo_url"/>";
                    
                    let cart = {}; // { productId: { name, price, qty, img } }
                    
                    // MainButton setup
                    tg.MainButton.text = "SO'ROVNI YUBORISH (0 so'm)";
                    tg.MainButton.color = tg.themeParams.button_color || "#10b981"; // Emerald green
                    
                    // UI Elements
                    const emptyCart = document.getElementById('emptyCart');
                    const cartList = document.getElementById('cartList');
                    const totalItemsBadge = document.getElementById('totalItemsBadge');
                    const searchInput = document.getElementById('searchInput');
                    
                    function updateMainButton() {
                        let totalAmount = 0;
                        let totalItems = 0;
                        
                        for (let id in cart) {
                            totalAmount += (cart[id].price * cart[id].qty);
                            totalItems++;
                        }
                        
                        if (totalAmount > 0) {
                            tg.MainButton.text = `SO'ROVNI YUBORISH (${totalAmount.toLocaleString()} so'm)`;
                            tg.MainButton.show();
                        } else {
                            tg.MainButton.hide();
                        }
                        
                        // Update UI
                        emptyCart.style.display = totalItems === 0 ? 'block' : 'none';
                        totalItemsBadge.textContent = `${totalItems} ta turdagi mahsulot`;
                        
                        renderCart();
                    }
                    
                    function addToCart(id, name, price, img) {
                        if (cart[id]) {
                            cart[id].qty++;
                        } else {
                            cart[id] = { name, price: parseFloat(price), qty: 1, img };
                        }
                        updateMainButton();
                        // Provide haptic feedback
                        if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
                    }
                    
                    function changeQty(id, delta) {
                        if (cart[id]) {
                            cart[id].qty += delta;
                            if (cart[id].qty &lt;= 0) {
                                delete cart[id];
                            }
                            updateMainButton();
                            if (tg.HapticFeedback) tg.HapticFeedback.selectionChanged();
                        }
                    }

                    function setQty(id, value) {
                        let qty = parseInt(value);
                        if (isNaN(qty) || qty &lt;= 0) {
                            delete cart[id];
                        } else {
                            cart[id].qty = qty;
                        }
                        updateMainButton();
                    }
                    
                    function renderCart() {
                        // Keep emptyCart logic separate
                        Array.from(cartList.children).forEach(child => {
                            if (child.id !== 'emptyCart') cartList.removeChild(child);
                        });
                        
                        for (let id in cart) {
                            const item = cart[id];
                            const doc = document.createElement('div');
                            doc.className = "flex items-center justify-between p-3 bg-white rounded-xl shadow-sm border border-gray-100";
                            doc.style.backgroundColor = "var(--tg-theme-bg-color, #ffffff)";
                            
                            doc.innerHTML = `
                                <div class="flex items-center space-x-3 flex-1 overflow-hidden">
                                    <div class="h-10 w-10 bg-gray-50 rounded-lg flex-shrink-0 flex items-center justify-center border border-gray-100 p-1">
                                        ${item.img ? `<img src="${item.img}" class="max-h-full object-contain" onerror="this.style.display='none'"/>` : `<i class="fa fa-box text-gray-300"></i>`}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="font-bold text-sm truncate">${item.name}</div>
                                        <div class="text-xs text-green-600 font-semibold">${item.price.toLocaleString()} UZS</div>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-1 ml-2 bg-gray-50 rounded-lg p-1 border border-gray-200">
                                    <button onclick="changeQty('${id}', -1)" class="w-8 h-8 flex items-center justify-center text-red-500 font-bold bg-white rounded shadow-sm hover:bg-gray-100 transition"><i class="fa ${item.qty === 1 ? 'fa-trash' : 'fa-minus'} text-sm"></i></button>
                                    <input type="number" onchange="setQty('${id}', this.value)" value="${item.qty}" class="w-10 text-center font-bold text-sm bg-transparent border-none outline-none m-0 p-0 text-gray-800" style="color:var(--tg-theme-text-color)"/>
                                    <button onclick="changeQty('${id}', 1)" class="w-8 h-8 flex items-center justify-center text-blue-500 font-bold bg-white rounded shadow-sm hover:bg-gray-100 transition"><i class="fa fa-plus text-sm"></i></button>
                                </div>
                            `;
                            cartList.appendChild(doc);
                        }
                    }
                    
                    // Setup Product Clicks
                    document.querySelectorAll('.product-card').forEach(card => {
                        card.addEventListener('click', function() {
                            const id = this.getAttribute('data-id');
                            const name = this.getAttribute('data-name');
                            const price = this.getAttribute('data-price');
                            const img = this.getAttribute('data-img');
                            addToCart(id, name, price, img);
                            
                            // Visual click effect
                            this.style.transform = 'scale(0.97)';
                            setTimeout(() => this.style.transform = 'scale(1)', 100);
                        });
                    });

                    // Search Feature
                    searchInput.addEventListener('input', function(e) {
                        const term = e.target.value.toLowerCase();
                        document.querySelectorAll('.product-card').forEach(card => {
                            const name = card.querySelector('.product-name').textContent.toLowerCase();
                            if (name.includes(term)) {
                                card.style.display = 'flex';
                            } else {
                                card.style.display = 'none';
                            }
                        });
                    });
                    
                    async function submitData() {
                        const lines = [];
                        for (let id in cart) {
                            lines.push({
                                product_id: parseInt(id),
                                qty: cart[id].qty
                            });
                        }
                        
                        const notes = document.getElementById('requestNotes').value;
                        
                        const payload = {
                            jsonrpc: "2.0",
                            method: "call",
                            params: {
                                partner_id: partnerId,
                                lines: lines,
                                notes: notes
                            }
                        };
                        
                        tg.MainButton.showProgress();
                        
                        try {
                            const response = await fetch(`${odooUrl}/van/client/submit_request`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify(payload)
                            });
                            
                            const data = await response.json();
                            if (data.result &amp;&amp; data.result.success) {
                                if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
                                // Use TG Native popup before closing
                                tg.showAlert("Sizning so'rovingiz muvaffaqiyatli jo'natildi! 🎉", function() {
                                    tg.close();
                                });
                            } else {
                                if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('error');
                                tg.showAlert("Xatolik yuz berdi: " + (data.result ? data.result.error : 'Noma\'lum xato.'));
                            }
                        } catch (error) {
                            if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('error');
                            tg.showAlert("Tarmoqda xatolik: " + error.message);
                        } finally {
                            tg.MainButton.hideProgress();
                        }
                    }
                    
                    // Bind main button click
                    tg.MainButton.onClick(submitData);
                    
                    // Initial state
                    updateMainButton();
                </script>
            </body>
        </html>
    </template>
</odoo>
