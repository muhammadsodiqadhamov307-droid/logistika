<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="van_sales_pharma.MaterialRequestPopup">
        <Dialog title="'Material So\'rovi'">
            <div class="popup-material-request" style="min-width: 500px; max-height: 400px; overflow-y: auto;">
                <div class="search-bar-container mb-3 d-flex gap-2">
                    <input type="text" 
                           class="form-control form-control-lg" 
                           placeholder="Mahsulot nomi yoki shtrix kodi..." 
                           t-on-keyup="onSearchInput" 
                           t-ref="searchInput"/>
                    <button class="btn btn-primary btn-lg" t-on-click="searchProducts">
                        <i class="fa fa-search"/>
                    </button>
                </div>
                
                <div class="search-results mb-4" t-if="state.searchResults.length > 0">
                    <h6 class="text-muted fw-bold mb-2">Qidiruv natijalari:</h6>
                    <div class="list-group shadow-sm">
                        <t t-foreach="state.searchResults" t-as="product" t-key="product.id">
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <img t-attf-src="/web/image?model=product.product&amp;id={{product.id}}&amp;field=image_128" alt="Mahsulot" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;"/>
                                    <span class="fw-bold"><t t-esc="product.display_name" /></span>
                                </div>
                                <button class="btn btn-sm btn-success px-3" t-on-click="() => this.addProduct(product)">
                                    <i class="fa fa-plus me-1"/> Qo'shish
                                </button>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="selected-products">
                    <h6 class="text-muted fw-bold mb-2">So'ralayotgan mahsulotlar:</h6>
                    <div class="card shadow-sm border-0">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mahsulot</th>
                                    <th style="width: 120px;" class="text-center">Miqdor</th>
                                    <th style="width: 60px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.selectedLines" t-as="line" t-key="line.id">
                                    <tr>
                                        <td class="align-middle ps-3 fw-bold"><t t-esc="line.product.display_name" /></td>
                                        <td class="align-middle px-2">
                                            <div class="input-group input-group-sm">
                                                <input type="number" 
                                                    class="form-control text-center" 
                                                    t-model.number="line.qty" 
                                                    min="1"/>
                                            </div>
                                        </td>
                                        <td class="align-middle text-center pe-2">
                                            <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.removeLine(line.id)">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="state.selectedLines.length === 0">
                                    <td colspan="3" class="text-center text-muted py-5">
                                        <i class="fa fa-inbox fa-3x mb-2 text-light" /><br/>
                                        Hozircha hech qanday mahsulot tanlanmagan
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <div class="w-100 d-flex gap-2">
                    <button class="button confirm btn btn-primary flex-grow-1" t-att-disabled="state.selectedLines.length === 0" t-on-click="confirm">
                        <i class="fa fa-paper-plane me-2"/> Tasdiqlashga Yuborish
                    </button>
                    <button class="button cancel btn btn-secondary flex-grow-1" t-on-click="props.close">
                        Bekor qilish
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
