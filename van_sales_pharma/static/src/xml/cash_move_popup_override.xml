<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="van_sales_pharma.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('form-floating')]" position="before">
            <div class="form-floating mb-2" t-if="state.type === 'in'">
                <select class="form-select" id="partnerSelection" t-on-change="onPartnerChange" t-model="customState.selectedPartnerId">
                    <option value="">-- Mijozni tanlang (Ixtiyoriy) --</option>
                    <t t-foreach="customState.partners" t-as="partner" t-key="partner.id">
                        <option t-att-value="partner.id">
                            <t t-esc="partner.name"/>
                        </option>
                    </t>
                </select>
                <label for="partnerSelection">Mijoz (Kirim / Qarz to'lash)</label>
            </div>
            <div class="alert alert-warning p-2 mb-2" style="font-size: 1.1em;" t-if="state.type === 'in' and customState.selectedPartnerId and customState.partnerDebt > 0">
                <i class="fa fa-info-circle me-2"></i> Mijozning joriy qarzi (Nasiya): <strong t-esc="env.utils.formatCurrency(customState.partnerDebt)"/>
            </div>
            <div class="alert alert-success p-2 mb-2" style="font-size: 1.1em;" t-if="state.type === 'in' and customState.selectedPartnerId and customState.partnerDebt &lt;= 0">
                <i class="fa fa-check-circle me-2"></i> Mijozning qarzi yo'q.
            </div>
        </xpath>
    </t>
</templates>
