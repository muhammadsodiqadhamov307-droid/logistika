<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Yuklash Wizard Formasi -->
    <record id="view_van_load_wizard_form" model="ir.ui.view">
        <field name="name">van.load.wizard.form</field>
        <field name="model">van.load.wizard</field>
        <field name="arch" type="xml">
            <form string="Mashinaga Yuklash">
                <group>
                    <field name="trip_id"/>
                    <field name="warehouse_id"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <notebook>
                    <page string="Qo'shiladigan Mahsulotlar">
                        <field name="load_line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_load" string="Yuklashni Tasdiqlash" type="object" class="btn-primary" close="1"/>
                    <button string="Bekor Qilish" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
