<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Yuklash Wizard Formasi -->
    <record id="view_van_load_wizard_form" model="ir.ui.view">
        <field name="name">van.load.wizard.form</field>
        <field name="model">van.load.wizard</field>
        <field name="arch" type="xml">
            <form string="Mashinaga Yuklash">
                <group>
                    <field name="trip_id"/>
                    <field name="warehouse_id"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <notebook>
                    <page string="Qo'shiladigan Mahsulotlar">
                        <field name="load_line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_load" string="Yuklashni Tasdiqlash" type="object" class="btn-primary"/>
                    <button string="Bekor Qilish" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Sayohatni Yopish Wizard Formasi -->
    <record id="view_van_trip_close_wizard_form" model="ir.ui.view">
        <field name="name">van.trip.close.wizard.form</field>
        <field name="model">van.trip.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Sayohatni Yopish">
                <group>
                    <group>
                        <field name="trip_id"/>
                        <field name="cash_expected" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="card_expected" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <!-- Mobile xodimlar tushunarli bo'lishi uchun yirik -->
                        <field name="cash_received" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-size: 1.2em; font-weight: bold;"/>
                        <field name="card_received" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-size: 1.2em; font-weight: bold;"/>
                    </group>
                </group>
                <notebook>
                    <page string="Qaytayotgan Mahsulotlar (Qoldiqlar)">
                        <field name="close_line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="product_id"/>
                                <field name="expected_return"/>
                                <field name="actual_return"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <field name="note" placeholder="Yopilish izohi yoki kutilmagan farq sabablari..."/>
                <footer>
                    <button name="action_close_trip" string="Yopishni Qabul Qilish" type="object" class="btn-success"/>
                    <button string="Bekor" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
